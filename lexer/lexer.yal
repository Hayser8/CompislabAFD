(* lexer.yal – Analizador léxico para un Python casi completo *)

{
# ---------- HEADER: código Python incrustado ----------
import sys

# Tabla de keywords de Python
keywords = {
    "False":"FALSE", "None":"NONE", "True":"TRUE", "and":"AND", "as":"AS",
    "assert":"ASSERT", "async":"ASYNC", "await":"AWAIT", "break":"BREAK",
    "class":"CLASS", "continue":"CONTINUE", "def":"DEF", "del":"DEL",
    "elif":"ELIF", "else":"ELSE", "except":"EXCEPT", "finally":"FINALLY",
    "for":"FOR", "from":"FROM", "global":"GLOBAL", "if":"IF",
    "import":"IMPORT", "in":"IN", "is":"IS", "lambda":"LAMBDA",
    "nonlocal":"NONLOCAL", "not":"NOT", "or":"OR", "pass":"PASS",
    "raise":"RAISE", "return":"RETURN", "try":"TRY", "while":"WHILE",
    "with":"WITH", "yield":"YIELD"
}

# Para manejar INDENT/DEDENT según niveles de espacio
indent_stack = [0]
pending_dedents = []
}

(* ─── Definiciones reutilizables ─── *)
let digit       = ['0'-'9']
let nondigit    = ['1'-'9']
let hexdigit    = digit | ['a'-'f'] | ['A'-'F']
let binprefix   = '0' ['b','B']
let octprefix   = '0' ['o','O']
let hexprefix   = '0' ['x','X']
let underscore  = '_'

let binint      = binprefix (digit|underscore)+
let octint      = octprefix (['0'-'7']|underscore)+
let hexint      = hexprefix (hexdigit|underscore)+
let decint      = nondigit (digit|underscore)* | '0'
let integer     = hexint | octint | binint | decint

let exponent    = ['e','E'] ['+','-']? (digit|underscore)+
let floatnum    = (digit|underscore)+ '.' (digit|underscore)* exponent?
                | '.' (digit|underscore)+ exponent?
                | (digit|underscore)+ exponent

let letter      = ['a'-'z''A'-'Z''_']
let identifier  = letter (letter|digit|underscore)*

let whitespace  = [' ' '\t']
let newline     = '\r'? '\n'

(* ─── Reglas del lexer ─── *)
rule gettoken =

  # 1) Si tengo DEDENTs pendientes, los devuelvo primero
  { if pending_dedents:
        return pending_dedents.pop(0) }

| newline whitespace*  {
    # Emite un NEWLINE y luego posibles INDENT/DEDENT
    count_nl = yytext.count('\n')
    indent   = len(yytext) - yytext.rfind('\n') - 1
    # siempre devolvemos NEWLINE primero:
    pending_action = ("NEWLINE","NEWLINE")
    # ahora manejamos indentación
    if indent > indent_stack[-1]:
        indent_stack.append(indent)
        pending_dedents.insert(0, ("INDENT","INDENT"))
    else:
        while indent < indent_stack[-1]:
            indent_stack.pop()
            pending_dedents.append(("DEDENT","DEDENT"))
    return pending_action
  }

| whitespace+          { /* se ignora */ }

| "#" [^\n]*           { return "COMMENT" }

| integer floatnum?    { return "NUMBER" }

| floatnum             { return "NUMBER" }

| identifier           {
      if lxm in keywords: return keywords[lxm]
      return "IDENTIFIER"
  }

# Literales de cadena con prefijos (r, u, f, b, rb, fr…)
| ([rRuUfFbB] | [rRuUfFbB][rRuUfFbB])? '"""' ( [^"] | '""' [^"] )* '"""' { return "STRING" }
| ([rRuUfFbB] | [rRuUfFbB][rRuUfFbB])? "'''" ( [^'] | "''" [^'] )* "'''" { return "STRING" }
| ([rRuUfFbB] | [rRuUfFbB][rRuUfFbB])? '"'  ( [^"\\\n] | '\\' . )* '"'   { return "STRING" }
| ([rRuUfFbB] | [rRuUfFbB][rRuUfFbB])? "'"  ( [^'\\\n] | '\\' . )* "'"   { return "STRING" }

# Operadores y delimitadores compuestos
| "=="  { return "EQ" }
| "!="  { return "NE" }
| "<="  { return "LE" }
| ">="  { return "GE" }
| ":="  { return "WALRUS" }
| "->"  { return "RARROW" }
| "\\*\\*"  { return "POW" }
| "//"  { return "FLOORDIV" }
| "\\+=" { return "PLUSEQ" }
| "-="  { return "MINEQ" }
| "\\*=" { return "TIMEQ" }
| "/="  { return "DIVEQ" }
| "%="  { return "MODEQ" }

# Símbolos simples
| "="   { return "ASSIGN" }
| "<"   { return "LT" }
| ">"   { return "GT" }
| "+"   { return "PLUS" }
| "-"   { return "MINUS" }
| "*"   { return "TIMES" }
| "/"   { return "DIV" }
| "%"   { return "MOD" }
| "@"   { return "AT" }
| ","   { return "COMMA" }
| ":"   { return "COLON" }
| ";"   { return "SEMICOLON" }
| "."   { return "DOT" }
| "("   { return "LPAREN" }
| ")"   { return "RPAREN" }
| "["   { return "LBRACKET" }
| "]"   { return "RBRACKET" }
| "{"   { return "LBRACE" }
| "}"   { return "RBRACE" }

| eof {
    # Al llegar a EOF, expulso todos los DEDENTs restantes
    while len(indent_stack) > 1:
      indent_stack.pop()
      pending_dedents.append(("DEDENT","DEDENT"))
    if pending_dedents:
      return pending_dedents.pop(0)
    raise("EOF")
  }

{
# ---------- TRAILER: se añade al final del código generado ----------
print("Fin de análisis léxico")
}
