# source.src — Archivo de prueba exhaustivo para tu parser YAPar

# Asignaciones simples y expresiones aritméticas
x = 1 + 2 * (3 - 4)

# Expresión condicional (if inline)
y = x if x > 0 else -x

# Operadores lógicos y comparaciones
flag = (x > 0) and not (y < 0) or False

# Comparaciones encadenadas y asignación de prueba (no walrus)
cmp1 = x == y
cmp2 = x != y

# Precedencia de divisiones y módulo
divmod_test = (10 / 3) * 2 % 5

# Listas y lista vacía
lst = [1, 2, 3]
empty_list = []

# Diccionarios y conjuntos
my_dict = {"a": 1, "b": 2}
my_set  = {1, 2, 3}

# Literales numéricas y de cadena
pi       = 3.14
s1       = "hello"
s2       = 'world'


# Valores especiales
nothing = None
tf      = True or False

# Definición de función con parámetros y valor por defecto, suite en semicolón
def foo(a, b=2):
    result = a * b + 5; return result

# Definición de función sin parámetros, suite en indentación
def bar():
    x = 0
    for i in lst:
        if i % 2 == 0:
            continue
        x = x + i
    else:
        x = -1
    return x

# Definición de clase sin y con herencia
class Baz:
    pass

class Qux(Baz):
    x = 10
    def method(self):
        return x

# Bucle while con else
i = 5
while i > 0:
    i = i - 1
else:
    i = -1

# Estructura if-elif-else completa
if x > y:
    max_val = x
elif x < y:
    max_val = y
else:
    max_val = 0

# Unarios
neg = -max_val
pos = +max_val

# Flow control dentro de función
def qux():
    for j in []:
        break
    while False:
        continue
    return None
